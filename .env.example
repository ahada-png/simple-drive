# Copy to your shell (or a .env loader) and pick one backend.

STORAGE_BACKEND=local          # local | database | s3 | ftp

# local
LOCAL_STORAGE_PATH=/home/john/server_storage

# s3 (values below match the docker-compose S3 server)
S3_ENDPOINT=http://localhost:5000
S3_BUCKET=simple-drive
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test
S3_FORCE_PATH_STYLE=true

# ftp (values below match docker-compose FTP)
FTP_HOST=localhost
FTP_PORT=21
FTP_USERNAME=drive
FTP_PASSWORD=drivepass
FTP_DIRECTORY=/simple-drive
FTP_PASSIVE=true

# Largest accepted blob in bytes (default 10 MB)
MAX_BLOB_SIZE=10485760
